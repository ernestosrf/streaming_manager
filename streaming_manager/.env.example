# Configurações do Flask (obrigatórias: a aplicação não inicia sem elas)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
JWT_SECRET_KEY=

# Administrador inicial (usado apenas na primeira migração para criar a conta)
# Depois disso, o login consulta usuários e senhas no banco.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Origens permitidas no CORS (separadas por vírgula)
# Produção: defina o domínio real, ex: https://seudominio.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Banco de dados
# Local: deixe vazio para usar SQLite (src/database/app.db)
DATABASE_URL=

# Desenvolvimento: habilita o debugger do Werkzeug (nunca em produção)
FLASK_DEBUG=false

# Rate limiting (login/cadastro). Em memória por padrão: com vários workers do
# gunicorn cada um tem o próprio contador; use Redis para um limite global,
# ex: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
# Cadastros bem-sucedidos por IP. Tentativas inválidas não entram na conta.
# Em desenvolvimento local, aumente se precisar criar várias contas de teste.
REGISTER_RATE_LIMIT='5 per hour'
# Número de proxies reversos à frente da app (Render = 1). Necessário para o
# rate limit usar o IP real do cliente em vez do IP do proxy.
TRUSTED_PROXY_COUNT=0
