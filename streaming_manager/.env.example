# Configurações do Flask
FLASK_SECRET_KEY=
JWT_SECRET_KEY=

# Administrador inicial
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Origens permitidas no CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Banco de dados: deixe vazio para usar SQLite
DATABASE_URL=

# Desenvolvimento: habilita o debugger do Werkzeug
FLASK_DEBUG=false

# Rate limiting (login/cadastro).
RATELIMIT_STORAGE_URI=memory://

REGISTER_RATE_LIMIT='5 per hour' # Cadastros bem-sucedidos por IP. 
TRUSTED_PROXY_COUNT=0 # Número de proxies reversos à frente da app (Render = 1). Necessário para o rate limit usar o IP real do cliente em vez do IP do proxy.

# TMDB (The Movie Database): https://www.themoviedb.org/settings/api. Vazio = busca externa desativada.
TMDB_API_KEY=
