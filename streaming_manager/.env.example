# Configurações do Flask
FLASK_SECRET_KEY=
JWT_SECRET_KEY=

# Administrador inicial (usado apenas na primeira migração para criar a conta)
# Depois disso, o login consulta usuários e senhas no banco.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Origens permitidas no CORS (separadas por vírgula)
# Produção: defina o domínio real, ex: https://seudominio.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Banco de dados
# Local: deixe vazio para usar SQLite (src/database/app.db)
DATABASE_URL=
